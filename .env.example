GROQ=                          # Azure: use a Key Vault reference, not a literal
SESSION_SECRET=                # openssl rand -hex 32
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
REQUIRE_SESSION_TOKEN=1        # set 0 only for local testing
TPM_LIMIT=7000                 # keep under your provider's tokens-per-minute cap
RATE_LIMIT_PER_MIN=20
BIG_MODEL=openai/gpt-oss-120b
SMALL_MODEL=openai/gpt-oss-20b
LOG_LEVEL=INFO
